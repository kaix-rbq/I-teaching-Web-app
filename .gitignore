# 沙箱/本地开发工具目录（内含本地 MySQL 实例，不入库）
.devtools/

# 编辑器与系统文件
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# 密钥与本地环境变量（严禁入库；ASR/数据库等凭据一律走环境变量）
.env
.env.local
.env.*.local
*.local.env

# AImodel 原型目录中的凭据笔记：历史上曾包含明文 API Key，禁止入库。
# 目录内的 .md 文档与脚本可正常跟踪，仅排除凭据载体。
AImodel/**/调用模型及api.txt
AImodel/**/*.local

# Windows 下载来源标记（随附件产生，无跟踪价值）
*:Zone.Identifier

# 本地联调素材（音频/视频体积大，不入库；脚本文件仍可跟踪）
test/*.mp3
test/*.wav
test/*.m4a
test/*.mp4
test/*.avi
